# ---- Core ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side writer role (never exposed to the browser)
DATABASE_URL=postgres://irk_app:irk_app_dev@localhost:5432/irk
# Read-only role used to render public pages (RLS: published content only)
DATABASE_READER_URL=postgres://irk_reader:irk_reader_dev@localhost:5432/irk
# Schema owner, used ONLY by `npm run db:migrate` / `db:seed`
DATABASE_OWNER_URL=postgres://irk_owner:irk_owner_dev@localhost:5432/irk
# Managed Postgres (Supabase, Neon, RDS): "require" (encrypted, unverified — libpq semantics)
# or "verify-full" with the provider CA in DATABASE_SSL_CA (PEM, \n-escaped allowed).
DATABASE_SSL=
DATABASE_SSL_CA=

# 32+ random bytes, base64. Used to hash IPs and sign tokens.  openssl rand -base64 32
APP_SECRET=dev-only-change-me-dev-only-change-me-000
# 32 random bytes, base64. AES-256-GCM key for verification evidence. openssl rand -base64 32
EVIDENCE_ENCRYPTION_KEY=

# ---- Ratings ----------------------------------------------------------------
RATING_CONFIDENCE_M=10
RATING_MIN_REVIEWS_OVERALL=10

# ---- Verification evidence -------------------------------------------------
# local | supabase
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./storage/private
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_EVIDENCE_BUCKET=verification-evidence
# Days evidence is kept after a decision (PENDING LEGAL APPROVAL)
VERIFICATION_RETENTION_DAYS=30

# ---- Email -----------------------------------------------------------------
# console (dev: stored in dev outbox) | resend
EMAIL_PROVIDER=console
EMAIL_FROM="Immigration Review Korea <no-reply@example.com>"
RESEND_API_KEY=

# ---- Translation -----------------------------------------------------------
# none | deepl | google | mock (mock is refused in production)
TRANSLATION_PROVIDER=none
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2/translate
GOOGLE_TRANSLATE_API_KEY=

# ---- Maps ------------------------------------------------------------------
# Kakao Maps JavaScript key. Without it, Leaflet + OpenStreetMap tiles are used.
NEXT_PUBLIC_KAKAO_MAP_KEY=

# ---- Jobs ------------------------------------------------------------------
CRON_SECRET=

# ---- Development -----------------------------------------------------------
# Show clearly labelled FICTIONAL sample reviews (ignored in production)
SAMPLE_DATA=true
